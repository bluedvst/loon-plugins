#!name=AvPlay 广告与追踪过滤
#!desc=AvPlay 1.9.1：安全拦截已识别的推广来源与追踪请求；不需要 MITM 证书。
#!version=1.3.0
#!author=Codex

[URL Rewrite]
# 已从 AvPlay 1.9.1 的 IPA 中确认的 Mixpanel 行为分析接口
^https?:\/\/api\.mixpanel\.com\/(?:track|engage|groups|decide|record)(?:\/|\?|$).* - reject

# Firebase 行为分析、崩溃上报与远程设置；不影响影片资源请求
^https?:\/\/[^\/]+\.app-measurement\.com\/.* - reject
^https?:\/\/firebaselogging\.googleapis\.com\/.* - reject
^https?:\/\/crashlyticsreports-pa\.googleapis\.com\/.* - reject
^https?:\/\/firebase-settings\.crashlytics\.com\/.* - reject

# 常见的独立广告资源接口。仅匹配路径或查询参数明确标记为广告的请求，避免误伤站点正文与视频。
^https?:\/\/[^\/]+\/(?:ads?|advertisement|banner|placements?)(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\/.*[?&](?:ad|ads|ad_id|adIds|advertisement|banner|placement)=[^&]* - reject

[Rule]
# 来自 AvPlay「应用推荐」截图中已识别的推广站点；规则按域名拒绝，无需解密 HTTPS。
DOMAIN-SUFFIX,91app1.com,REJECT
DOMAIN-SUFFIX,91ab.me,REJECT
DOMAIN-SUFFIX,bluemv.tips,REJECT
DOMAIN-SUFFIX,haijiao.fun,REJECT
DOMAIN-SUFFIX,lygay.com,REJECT
