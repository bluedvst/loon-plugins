#!name=AvPlay 广告配置清理
#!desc=AvPlay 1.9.1：清空应用推荐与轮播广告数据。需启用 MITM 并安装、完全信任 Loon CA；仅解密 www.javrocket.top。
#!version=1.5.0
#!author=Codex

[Script]
http-request ^https:\/\/www\.javrocket\.top\/avplayground_config\.json(?:\?|$) script-path=https://raw.githubusercontent.com/bluedvst/loon-plugins/main/AvPlay_AdClean.js?v=1.5.0,timeout=10,tag=AvPlay配置缓存刷新
http-response ^https:\/\/www\.javrocket\.top\/avplayground_config\.json(?:\?|$) script-path=https://raw.githubusercontent.com/bluedvst/loon-plugins/main/AvPlay_AdClean.js?v=1.5.0,requires-body=true,timeout=10,tag=AvPlay广告配置清理

[MITM]
hostname = www.javrocket.top
