#!name=肉视频去广告（保守版）
#!desc=仅隐藏网页中的已知广告链接，保留播放器和所有视频请求。更新后请重启 App。
#!author=Adapted from luestr/userscripts
#!version=1.2.0

[Rewrite]
^https?:\/\/(?:www\.)?(?:rou\.video|rouvmo\.com|roumanw\.com)(?:\/|$) header-replace Accept-Encoding identity

[Script]
http-response ^https?:\/\/(?:www\.)?(?:rou\.video|rouvmo\.com|roumanw\.com)(?:[\/:?]|$) script-path=https://raw.githubusercontent.com/bluedvst/loon-plugins/main/RouVideo_Adblock_safe.js,requires-body=true,timeout=15,tag=肉视频广告隐藏

[MITM]
hostname = rou.video, www.rou.video, rouvmo.com, www.rouvmo.com, roumanw.com, www.roumanw.com
