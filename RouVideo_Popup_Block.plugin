#!name=肉视频悬浮广告拦截
#!desc=拦截抓包确认的弹窗广告来源，并处理狭窄的 Radix 弹窗残留；部分域名规则影响其他应用。
#!author=bluedvst
#!version=1.4.0

[Rule]
DOMAIN,cdn-fc.com,REJECT
DOMAIN,fh-wgt.com,REJECT
DOMAIN,creative.greentrafsa.com,REJECT
DOMAIN,go.greentrafsa.com,REJECT
DOMAIN,go.mnaspm.com,REJECT
DOMAIN,a.realsrv.com,REJECT
DOMAIN,3pkf5m0gd.com,REJECT
DOMAIN,holahupa.com,REJECT
DOMAIN,nimhuemark.com,REJECT

[Rewrite]
^https?:\/\/ptelastaxo\.com\/b\.[^?]* reject-200
^https?:\/\/(?:www\.)?rouvmo\.com(?:\/|$) header-replace Accept-Encoding identity

[Script]
http-response ^https?:\/\/(?:www\.)?rouvmo\.com(?:[\/:?]|$) script-path=https://raw.githubusercontent.com/bluedvst/loon-plugins/main/RouVideo_Line_Fix.js,requires-body=true,timeout=15,tag=肉视频横线修复

[MITM]
hostname = ptelastaxo.com, rouvmo.com, www.rouvmo.com
